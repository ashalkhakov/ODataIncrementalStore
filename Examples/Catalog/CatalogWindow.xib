                                <connections>
                                    <action selector="terminate:" target="-1" id="AQ"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
            <point key="canvasLocation" x="-46" y="124"/>
        </menu>
        <window title="OIS Catalog" releasedWhenClosed="NO" animationBehavior="default" id="WIN">
