                                <items>
                                    <menuItem title="Product" state="on" id="EP"/>
                                    <menuItem title="Supplier" id="ES"/>
                                    <menuItem title="Location" id="EL"/>
                                    <menuItem title="Stock" id="EK"/>
                                    <menuItem title="Category" id="EC"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                        <connections>
                            <action selector="entityChanged:" target="-2" id="AE"/>
                        </connections>
                    </popUpButton>
                    <textField focusRingType="none" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="SRCH">
                        <rect key="frame" x="168" y="524" width="420" height="22"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" placeholderString="unitPrice &gt; 20 AND discontinued == NO" drawsBackground="YES" id="SRCHC"/>
                        <connections>
                            <action selector="runFetch:" target="-2" id="AS"/>
                        </connections>
                    </textField>
                    <button fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GO">
                        <rect key="frame" x="600" y="520" width="80" height="28"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Fetch" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="GOC">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        </buttonCell>
                        <connections>
                            <action selector="runFetch:" target="-2" id="AG"/>
                        </connections>
                    </button>
                    <button fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="SAVE">
                        <rect key="frame" x="688" y="520" width="80" height="28"/>
