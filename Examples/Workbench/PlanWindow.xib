            <rect key="contentRect" x="160" y="160" width="860" height="640"/>
            <view key="contentView" id="PWINV">
                <rect key="frame" x="0.0" y="0.0" width="860" height="640"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <scrollView borderType="bezelBorder" autohidesScrollers="YES" hasVerticalScroller="YES" hasHorizontalScroller="NO" id="PREQS">
                        <rect key="frame" x="8" y="572" width="844" height="60"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <clipView key="contentView" id="PREQCL">
                            <rect key="frame" x="1" y="1" width="842" height="58"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <textView editable="NO" importsGraphics="NO" richText="NO" id="PREQ">
                                    <rect key="frame" x="0.0" y="0.0" width="842" height="58"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                </textView>
                            </subviews>
                        </clipView>
                        <scroller key="verticalScroller" verticalHuggingPriority="750" id="PREQVS"/>
                    </scrollView>
                    <splitView id="PSPL">
                        <rect key="frame" x="8" y="30" width="844" height="534"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView borderType="bezelBorder" autohidesScrollers="YES" hasVerticalScroller="YES" hasHorizontalScroller="NO" id="PPHYS">
                                <rect key="frame" x="0" y="272" width="844" height="262"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <clipView key="contentView" id="PPHYCL">
                                    <rect key="frame" x="1" y="1" width="842" height="260"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <subviews>
                                        <textView editable="NO" importsGraphics="NO" richText="NO" id="PPHY">
