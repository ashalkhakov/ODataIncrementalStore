                <outlet property="planWindow" destination="PWIN" id="oPWIN"/>
                <outlet property="explainedView" destination="PREQ" id="oPREQ"/>
                <outlet property="physicalPlanView" destination="PPHY" id="oPPHY"/>
                <outlet property="logicalPlanView" destination="PLOG" id="oPLOG"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Plan" releasedWhenClosed="NO" visibleAtLaunch="NO" id="PWIN">
