    <font key="font" metaFont="system"/>
    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
</textFieldCell>
                    </textField>
                    <scrollView borderType="bezelBorder" autohidesScrollers="YES" hasVerticalScroller="YES" hasHorizontalScroller="NO" id="SORTS">
                        <rect key="frame" x="16" y="576" width="300" height="86"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <clipView key="contentView" id="SORTCL">
                            <rect key="frame" x="1" y="1" width="298" height="84"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView multipleSelection="NO" headerView="SORTH" id="SORT">
                                    <rect key="frame" x="0.0" y="0.0" width="298" height="61"/>
