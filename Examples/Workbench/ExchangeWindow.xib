            <rect key="contentRect" x="120" y="120" width="860" height="640"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1920" height="1055"/>
            <view key="contentView" id="XWINV">
                <rect key="frame" x="0.0" y="0.0" width="860" height="640"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <splitView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="XSPL">
                        <rect key="frame" x="8" y="30" width="844" height="602"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView fixedFrame="YES" autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="XREQS">
                                <rect key="frame" x="0.0" y="0.0" width="844" height="297"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <clipView key="contentView" id="XREQCL">
                                    <rect key="frame" x="1" y="1" width="842" height="295"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <subviews>
                                        <textView editable="NO" importsGraphics="NO" richText="NO" verticallyResizable="NO" id="XREQ">
                                            <rect key="frame" x="0.0" y="0.0" width="842" height="1"/>
