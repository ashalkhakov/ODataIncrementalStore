                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                        <textFieldCell key="cell" id="XNOTEC">
                            <font key="font" metaFont="system"/>
                            <string key="title">As the store sent and received it. The URL loading system may add headers of its own (Host, Content-Length) and undoes compression.</string>
