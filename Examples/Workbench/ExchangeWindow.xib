                <outlet property="requestView" destination="XREQ" id="oXREQ"/>
                <outlet property="responseView" destination="XRES" id="oXRES"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Exchange" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="XWIN">
