    "body": {
      "@odata.context": "https://odata.test/V4/Northwind.svc/$metadata#Products",
      "value": [
        {
          "ProductID": 14,
          "ProductName": "Tofu",
          "UnitPrice": 23.25,
          "Category": {
            "CategoryID": 7
          }
        }
      ]
    }
  }
}
