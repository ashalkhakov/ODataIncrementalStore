{
  "comment": "Collection GET with $filter $orderby $top. ABNF: gtExpr, andExpr, boolLiteral.",
  "spec": "OASIS OData 4.0 Protocol \u00a711.2.5.1 / \u00a711.2.5.2 / \u00a711.2.5.7",
  "predicate": "unitPrice > 20 AND discontinued == NO",
  "request": {
    "method": "GET",
    "path": "Products",
    "query": {
      "$filter": "(UnitPrice gt 20) and (Discontinued eq false)",
      "$orderby": "ProductName,ProductID",
      "$top": "25",
      "$expand": "Category($select=CategoryID)"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json;odata.metadata=minimal;charset=utf-8",
      "OData-Version": "4.0"
